# ============================================================
# 生产环境变量模板
# 本文件不含真实值。部署时复制为 .env（或在部署机本地填写），
# 真实密钥只存在于部署机，永不入库。
# ============================================================

DB_PASSWORD=CHANGE_ME_DB_PASSWORD
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
NVIDIA_API_KEY=your-nvidia-api-key-here
REDIS_PASSWORD=
