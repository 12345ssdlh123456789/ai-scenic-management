# ============================================================
# 环境变量示例 —— 复制为 .env 后按需修改
#   copy .env.example .env
# start.bat / run-backend.bat 会自动读取 .env 文件。
# 注意：不要把 .env 提交到 Git（.gitignore 已排除）。
# 本文件只放占位符，真实值一律写在 .env 里，永不入库。
# ============================================================

# 数据库密码（必填，与本地 MySQL root 密码一致）
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# JWT 签名密钥（必填，至少 32 字符）
# 生成方法（任选其一）：
#   PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
#   Python:     python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# NVIDIA API Key（选填，不填则 AI 客服不可用，其他功能正常）
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Redis（选填；留空时脚本会使用 localhost:6379）
# 若本机 Redis 未运行，缓存与限流会降级，且刷新 token 会失败（需重新登录）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
